+        static int segs = -2, seg, after; extern volatile int g_game_shot_req;
+        if (segs == -2) { const char *v = getenv("LINDBERGH_VT3_RVSHOT"); segs = v && *v ? atoi(v) : 0; }
+        if (segs > 0) {
+            if (k && !was) seg++;
