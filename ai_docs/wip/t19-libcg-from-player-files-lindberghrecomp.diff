+def apply_reloc(img, base, off, t, S):
+    """One i386 REL relocation on a loaded image, as solib.c's apply_relocs()
+    does it again at start-up (A is what the image holds there now)."""
+    A = struct.unpack_from("<I", img, off)[0]
+    if t == R_386_RELATIVE:
+        v = base + A
+    elif t == R_386_32:
+        v = S + A
+    elif t == R_386_PC32:
+        v = S + A - (base + off)
+    else:                              # R_386_GLOB_DAT, R_386_JMP_SLOT
+        v = S
+    struct.pack_into("<I", img, off, v & 0xFFFFFFFF)
