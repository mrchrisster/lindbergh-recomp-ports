++// Both views' layers of a rectangle texture (the eyes), 1:1 into the 2D
++// texture dst's own array, which is then sampled per view (mv_layered): a
++// copy of the screen kept at the eye's size and per eye - Virtua Tennis 3's
++// ground shadow mask, which the game copies at 1360x768 from one eye. dst's
++// size picks the array's (array_for); the pixels outside the eye stay as they are.
++int gl4es_multiview_copy_layers(GLuint src, GLuint dst)
++{
++    gltexture_t* s = gl4es_getTexture(GL_TEXTURE_RECTANGLE_ARB, src);
++    gltexture_t* d = gl4es_getTexture(GL_TEXTURE_2D, dst);
++    if(!gl4es_mv || !s || !s->mvarray || !d || !d->glname) return 0;
++    GLuint a = array_for(d);
++    if(!a) return 0;
++    d->mv_layered = 1;
++    int w = s->mv_w < d->mv_w ? s->mv_w : d->mv_w, h = s->mv_h < d->mv_h ? s->mv_h : d->mv_h;
++    GLuint fb[2] = {0, 0};
++    GLint read = 0, draw = 0;
++    mv.GetIntegerv(0x8CAA /*GL_READ_FRAMEBUFFER_BINDING*/, &read);
++    mv.GetIntegerv(0x8CA6 /*GL_DRAW_FRAMEBUFFER_BINDING*/, &draw);
++    mv.GenFramebuffers(2, fb);
++    int scissor = mv.IsEnabled(GL_SCISSOR_TEST);
++    if(scissor) mv.Disable(GL_SCISSOR_TEST);
++    for(int l = 0; l < 2; l++) {
++        mv.BindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
++        mv.FramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, s->mvarray, 0, l);
++        mv.BindFramebuffer(GL_DRAW_FRAMEBUFFER, fb[1]);
++        mv.FramebufferTextureLayer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, a, 0, l);
++        mv.BlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
++    }
++    if(scissor) mv.Enable(GL_SCISSOR_TEST);
++    mv.BindFramebuffer(GL_READ_FRAMEBUFFER, read);
++    mv.BindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
++    mv.DeleteFramebuffers(2, fb);
++    return 1;
++}
++
++// The LOD bias (GL_TEXTURE_LOD_BIAS, which GLES lacks) of the 2D texture
++// bound on a unit, as the game set it: Virtua Tennis 3 asks -1 for its crowd
++// and many other textures; the runtime's fragment shaders apply it.
++float gl4es_texture_lod_bias(int unit)
++{
++    if(unit < 0 || unit >= MAX_TEX) return 0.0f;
++    gltexture_t* t = glstate->texture.bound[unit][ENABLED_TEX2D];
++    return t ? t->lg_lod_bias : 0.0f;
++}
++
