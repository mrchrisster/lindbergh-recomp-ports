+/* ---- a split screen's next pane, anti-aliasing on ----
+ * Virtua Tennis 3's two-pane reaction cam draws each pane as a frame of its
+ * own: a colour + stencil clear of the WHOLE screen (no scissor), the pane's
+ * planar shadows (whole viewport), a whole-screen copy - the pane's ground
+ * shadow mask - then a depth-only clear of its half (0,0 680x768, then
+ * 680,0 680x768) and the pane. The second pane's colour clear would wipe the
+ * first pane (the game brings it back from a screen copy, a composite that
+ * is left out here), so it goes (the flat-frame rule in the clear handler),
+ * and the second pane's mask copy takes the right half as it was left.
+ * With the eyes multisampled by implicit resolve
+ * (GL_OVR_multiview_multisampled_render_to_texture) every copy of the eyes
+ * resolves them, and what the multisampled buffer holds after a resolve is
+ * undefined: on the Quest one tile of the right half (x 50-75 %, y 50-100 %
+ * of the eye) came back holding the left pane squeezed in, the mask copy
+ * took it, and the right pane's ground and walls showed the left pane dark
+ * and see-through. So while anti-aliasing is on, such a dropped clear still
+ * clears the colour outside the panes already drawn this frame (their
+ * part-screen depth-only clears): the next pane's mask is the clear colour
+ * and its own shadows, as on the cabinet, whatever the tiles came back with.
+ * A scissored clear: no extra pass. LINDBERGH_PANE_CLEAR=0: as before;
+ * anti-aliasing off: unchanged. */
+static unsigned g_pane_frame = ~0u;
+static int      g_pane[4];              /* this frame's panes so far, one box: x0, y0, x1, y1 (game pixels) */
+static int pane_clear_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *v = getenv("LINDBERGH_PANE_CLEAR"); on = !(v && *v == '0'); }
+    return on;
+}
+static void pane_note(void)             /* a depth-only clear of part of the eyes: a pane */
+{
+    const int x0 = g_vp[0], y0 = g_vp[1], x1 = g_vp[0] + g_vp[2], y1 = g_vp[1] + g_vp[3];
+    if (g_vp[2] <= 0 || g_vp[3] <= 0 || (x0 <= 0 && y0 <= 0 && x1 >= GAME_W && y1 >= GAME_H)) return;
+    if (g_pane_frame != g_frame) { g_pane_frame = g_frame; g_pane[0] = x0; g_pane[1] = y0; g_pane[2] = x1; g_pane[3] = y1; return; }
+    if (x0 < g_pane[0]) g_pane[0] = x0;
+    if (y0 < g_pane[1]) g_pane[1] = y0;
+    if (x1 > g_pane[2]) g_pane[2] = x1;
+    if (y1 > g_pane[3]) g_pane[3] = y1;
+}
+static void pane_clear_rest(void)       /* a whole-screen colour clear being dropped: clear what no pane holds yet */
+{
+#ifdef LINDBERGH_GL4ES
+    if (g_msaa <= 0 || g_pane_frame != g_frame || !pane_clear_on()) return;
+    int r[4];                           /* x, y, w, h of the rest, game pixels */
+    const int x0 = g_pane[0], y0 = g_pane[1], x1 = g_pane[2], y1 = g_pane[3];
+    if (y0 <= 0 && y1 >= GAME_H && x0 <= 0 && x1 < GAME_W) { r[0] = x1; r[1] = 0; r[2] = GAME_W - x1; r[3] = GAME_H; }
+    else if (y0 <= 0 && y1 >= GAME_H && x1 >= GAME_W && x0 > 0) { r[0] = 0; r[1] = 0; r[2] = x0; r[3] = GAME_H; }
+    else if (x0 <= 0 && x1 >= GAME_W && y0 <= 0 && y1 < GAME_H) { r[0] = 0; r[1] = y1; r[2] = GAME_W; r[3] = GAME_H - y1; }
+    else if (x0 <= 0 && x1 >= GAME_W && y1 >= GAME_H && y0 > 0) { r[0] = 0; r[1] = 0; r[2] = GAME_W; r[3] = y0; }
+    else return;                        /* the panes cover the screen, or leave no one box */
+    const float sx = g_cur_k[0], sy = g_cur_k[1];
+    const GLint X = (GLint)lroundf(r[0] * sx), Y = (GLint)lroundf(r[1] * sy);
+    const GLint W = (GLint)lroundf((r[0] + r[2]) * sx) - X, H = (GLint)lroundf((r[1] + r[3]) * sy) - Y;
+    if (!g_scissor_on) glEnable(GL_SCISSOR_TEST);
+    glScissor(X, Y, W, H);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (g_scissor_on) glScissor(g_scissor[0], g_scissor[1], g_scissor[2], g_scissor[3]);
+    else glDisable(GL_SCISSOR_TEST);
+    static unsigned told; static int n;
+    if (n < 3 || g_frame - told > 600) { n++; told = g_frame;
+        fprintf(stderr, "[stereo] frame %u: split screen, anti-aliasing on: colour cleared outside the panes drawn (%d,%d %dx%d of the game's screen)\n",
+                g_frame, r[0], r[1], r[2], r[3]); }
+#endif
+}
